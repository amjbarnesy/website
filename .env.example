# Resend API key for the /api/contact form endpoint.
# Get it from https://resend.com (Account → API Keys), then:
#   - local:  copy this file to .env and paste your key below
#   - Vercel: add RESEND_API_KEY under Project Settings → Environment Variables
#             (scope to Production AND Preview)
RESEND_API_KEY=re_your_key_here

# Sanity (the blog backend — project "adambarnes-blog").
# These are public identifiers, not secrets; src/lib/sanity.ts hard-codes them
# as defaults, so setting these is optional (only needed to point at a different
# project/dataset).
SANITY_PROJECT_ID=03e66gen
SANITY_DATASET=production

# Cloudflare Turnstile (spam check on the contact form).
# Create a widget at https://dash.cloudflare.com → Turnstile (mode: Invisible,
# or Managed — the form uses appearance "interaction-only" either way) and add
# www.adambarnes.biz + localhost as hostnames.
# The site key is public and is baked into contact.html at BUILD time, so
# changing it in Vercel needs a redeploy. The secret is server-only.
# For local testing, Cloudflare's dummy keys are:
#   always passes: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
#   always fails:  2x00000000000000000000AB / 2x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Upstash Redis for contact-form rate limiting (3 per IP per 10 minutes).
# Optional: without these, an in-memory limiter is used, which resets per
# function instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
